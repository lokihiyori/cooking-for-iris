{
  "rules": {
    "dishes": {
      ".read": true,
      "$dishId": {
        ".write": "auth != null && auth.uid === 'xe9r51KY4iYsyWy4aTk1TJHHqNt1'",
        ".validate": "newData.hasChildren(['id', 'name', 'emoji', 'category', 'description', 'cookTime', 'ingredients', 'recipe'])"
      }
    },
    "orders": {
      ".read": "auth != null && auth.uid === 'xe9r51KY4iYsyWy4aTk1TJHHqNt1'",
      "$orderId": {
        ".write": "(auth != null && auth.uid === 'xe9r51KY4iYsyWy4aTk1TJHHqNt1') || (!data.exists() && newData.hasChildren(['id', 'items', 'status', 'timestamp']) && newData.child('status').val() === 'pending')",
        ".validate": "newData.hasChildren(['id', 'items', 'status', 'timestamp']) && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'cooking' || newData.child('status').val() === 'done')"
      }
    }
  }
}
